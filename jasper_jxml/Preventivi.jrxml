	<parameter name="id_preventivo" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
p.id_anagrafica,
p.anno_preventivo,
p.numero_documento,
p.data_preventivo,
p.oggetto,
p.riferimento_cliente,
p.totale_imponibile,
p.totale_sconto,
p.totale_iva,
p.totale,
pr.descrizione,
pr.quantita,
pr.prezzo_unitario,
pr.sconto,
pr.importo_scontato,
pr.iva,
pr.totale as TotalePreventivo,
pr.posizione,
a.ragione_sociale,
a.piva,
a.codice_fiscale,
s.indirizzo,
s.cap,
s.comune,
s.provincia
 FROM tb_preventivi as p
 LEFT JOIN tb_anagrafiche as a
 ON p.id_anagrafica=a.id_anagrafica
 LEFT JOIN tb_sedi AS s
 ON p.id_anagrafica=s.id_anagrafica AND id_tipo=1
 LEFT JOIN tb_preventivi_righe as pr
 ON p.id_preventivo=pr.id_preventivo
 WHERE p.id_preventivo=$P{id_preventivo}]]>
	</queryString>
