### Environment variables for MyChatElectron ###
### Copy this file to `.env.local` or adjust for your environment ###

# API root (default matches the web app)
VITE_API_BASE_URL=https://gestionale.mediaprint.it/pubblica

# Login endpoint used by the shared AuthContext (optional override)
VITE_AUTH_LOGIN_URL=https://gestionale.mediaprint.it/pubblica/login.php

# Instant messaging WebSocket endpoint
VITE_IM_WS_URL=wss://wss.mediaprint.it/ws/im
VITE_IM_WS_PATH=/ws/im

# Electron-specific overrides (only used if you launch renderer manually)
#ELECTRON_RENDERER_URL=http://localhost:4173
#NODE_ENV=production
